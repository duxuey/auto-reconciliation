# 服务
NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://127.0.0.1:5173

# PostgreSQL 16（本系统自有库）
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/db_biz_reconciliation

# 多租户占位：当前不做隔离，固定注入
TENANT_ID=00000000000000000000000000
DEFAULT_ACTOR=user:local
BUSINESS_TIME_ZONE=Asia/Shanghai
LOG_LEVEL=info

# 单次执行上限（两侧各）；0 = 暂不限制，后续通过配置管控
MAX_RUN_ROWS=0

# ri-service（只读参考，不直连其 MySQL）
RI_SERVICE_BASE_URL=http://localhost:8016

# 未显式选择环境时使用（对应 biz_reconciliation_environment.env_code）
DEFAULT_ENVIRONMENT_CODE=TEST

# 测试环境 MySQL 源库只读抽取（同一实例按系统分 schema；FILE 模式不需要）
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=readonly
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=fpic_ri_acc_db

# 生产环境密码：环境表中的 db_password_env_key 指向变量名，连接信息在「环境配置」页面维护
PROD_MYSQL_PASSWORD=
# SIT / UAT 环境密码（由部署环境注入，不提交真实值）
SIT_MYSQL_PASSWORD=
UAT_MYSQL_PASSWORD=

VITE_API_BASE_URL=http://127.0.0.1:3100

# 企业微信自动对账通知（页面只保存下方变量名，实际值由部署环境注入）
# 群机器人 Webhook 完整地址
WECOM_WEBHOOK_URL=
# 企业应用 Secret（CorpID / AgentID 在「自动对账」页面填写）
WECOM_APP_SECRET=
