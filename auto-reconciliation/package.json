{
  "name": "auto-reconciliation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @infra/biz-reconciliation dev",
    "dev:web": "pnpm --filter @infra/biz-reconciliation-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && pnpm --filter @infra/biz-reconciliation repo:lint",
    "test": "pnpm -r test",
    "test:oracle": "pnpm --filter @infra/biz-reconciliation test:oracle",
    "test:e2e": "pnpm --filter @infra/biz-reconciliation-web test:e2e",
    "db:generate": "pnpm --filter @infra/biz-reconciliation db:generate",
    "db:migrate": "pnpm --filter @infra/biz-reconciliation db:migrate",
    "seed": "pnpm --filter @infra/biz-reconciliation seed",
    "clean:reconciliation": "pnpm --filter @infra/biz-reconciliation clean:reconciliation",
    "contracts:extract": "pnpm --filter @infra/biz-reconciliation contracts:extract"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
